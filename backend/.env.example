# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Client URLs (CORS)
CLIENT_URL_EMPLOYER=http://localhost:3000
CLIENT_URL_ADMIN=http://localhost:3000

# Database (Neon PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/jobportal?sslmode=require"

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars
JWT_REFRESH_EXPIRY=7d

# File Storage (Cloudflare R2 S3-Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
R2_BUCKET_NAME=jobportal-private-files
R2_PUBLIC_DOMAIN=https://cdn.yourdomain.com

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Push Notifications (Firebase FCM)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# SMS / OTP Provider
SMS_API_KEY=your_sms_provider_api_key
SMS_SENDER_ID=JOBPRT

# Transactional Email (SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password
EMAIL_FROM="Job Portal <noreply@yourdomain.com>"
