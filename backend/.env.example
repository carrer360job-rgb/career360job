# ==============================================================================
# Career360 Core Backend API - Environment Configuration Example
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=development
API_BASE_URL=https://career360job-backend.vercel.app

# Client CORS Allowed Origins
CLIENT_URL_EMPLOYER=http://localhost:3000
CLIENT_URL_ADMIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database & Storage
# ------------------------------------------------------------------------------
# Transaction pooler (Port 6543) for serverless API queries:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (Port 5432) for direct migrations and schema changes:
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API Keys (Project Settings -> API)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM) - Exclusively for Push Notifications
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"..."}'

# ------------------------------------------------------------------------------
# JWT Authentication Tokens
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Posting Plans & Upgrades)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_ENABLE_LIVE=false

# ------------------------------------------------------------------------------
# Universal Email Notification Service (Gmail SMTP)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=your-admin-email@gmail.com
EMAIL_FROM="Career360 <your-email@gmail.com>"
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_gmail_app_password

# Standard SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
SMTP_SECURE=true
