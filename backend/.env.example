# ==============================================================================
# Career360 Platform - Environment Configuration Example
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=development
API_BASE_URL=https://backend-ten-nu-89.vercel.app

# Client CORS Origins
CLIENT_URL_EMPLOYER=http://localhost:3000
CLIENT_URL_ADMIN=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database (Neon / Supabase / Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/jobportal?sslmode=require"

# ------------------------------------------------------------------------------
# JWT Authentication Tokens
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# Firebase Admin SDK
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=career360-95daa
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@career360-95daa.iam.gserviceaccount.com
# For Vercel, paste the minified JSON string of your service account:
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"career360-95daa",...}'

# ------------------------------------------------------------------------------
# Transactional Email Service (Choose Option A or Option B)
# ------------------------------------------------------------------------------
EMAIL_FROM="Career360 Security <noreply@career360.com>"

# Option A: Gmail App Password
# (Generate 16-character code at https://myaccount.google.com/apppasswords)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_gmail_app_password

# Option B: Custom SMTP (Resend, SendGrid, Amazon SES, Mailgun, Brevo)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# Optional 3rd Party Integrations
# ------------------------------------------------------------------------------
# Cloudflare R2 Storage (Resumes, Avatars)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jobportal-private-files
R2_PUBLIC_DOMAIN=https://cdn.yourdomain.com

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
