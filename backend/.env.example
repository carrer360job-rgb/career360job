# ==============================================================================
# Career360 Core Backend API - Environment Configuration Example
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=development
API_BASE_URL=https://career360job-backend.vercel.app

# Client CORS Allowed Origins
CLIENT_URL_EMPLOYER=http://localhost:3000
CLIENT_URL_ADMIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Supabase API and Storage
# ------------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM) - Exclusively for Push Notifications
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"..."}'

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Posting Plans & Upgrades)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_ENABLE_LIVE=false
