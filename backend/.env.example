# ==============================================================================
# Career360 Platform - Environment Configuration Example
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=development
API_BASE_URL=https://career360job-backend.vercel.app

# Client CORS Origins
CLIENT_URL_EMPLOYER=http://localhost:3000
CLIENT_URL_ADMIN=http://localhost:5173

# ------------------------------------------------------------------------------
# JWT Authentication Tokens
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# Firebase Admin SDK
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=career360-7f60f
FIREBASE_SERVICE_ACCOUNT={"project_id":"...","client_email":"...","private_key":"..."}
# Or use these two variables with FIREBASE_PROJECT_ID instead of FIREBASE_SERVICE_ACCOUNT:
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Cloudinary resume storage (keep the API secret on this server only)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay posting payments. Use test credentials until checkout is verified.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Set true only after live payment review and release approval.
RAZORPAY_ENABLE_LIVE=false

# ------------------------------------------------------------------------------
# Email Service (Gmail SMTP)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=your-admin-email@gmail.com
EMAIL_FROM="Career360 <your-email@gmail.com>"
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_gmail_app_password

# Standard SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
SMTP_SECURE=true
